  <Target Name="ValidateDerailValleyReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(DVInstallPath)' == ''"
           Text="Set DVInstallPath to the Derail Valley installation, for example /p:DVInstallPath=&quot;C:\Steam\steamapps\common\Derail Valley&quot;." />
    <Error Condition="!Exists('$(DVManagedPath)\Assembly-CSharp.dll')"
           Text="DVInstallPath does not contain DerailValley_Data\Managed\Assembly-CSharp.dll: $(DVInstallPath)" />
    <Error Condition="!Exists('$(DVModsPath)\CommsRadioAPI\CommsRadioAPI.dll')"
           Text="CommsRadioAPI 1.0.3 is required at $(DVModsPath)\CommsRadioAPI\CommsRadioAPI.dll." />
  </Target>

  <Target Name="CopyToDerailValleyMods" AfterTargets="Build" Condition="'$(BuildGameCopy)' == 'true'">
    <PropertyGroup>
      <RevisedDVRouteModDirectory>$(DVModsPath)\$(AssemblyName)</RevisedDVRouteModDirectory>
    </PropertyGroup>
    <ItemGroup>
      <RevisedDVRouteAudio Include="$(ProjectDir)Resources\audio\*.wav" />
    </ItemGroup>
    <MakeDir Directories="$(RevisedDVRouteModDirectory);$(RevisedDVRouteModDirectory)\audio" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevisedDVRouteModDirectory)" />
    <Copy SourceFiles="$(ProjectDir)..\Info.json" DestinationFolder="$(RevisedDVRouteModDirectory)" />
    <Copy SourceFiles="@(RevisedDVRouteAudio)" DestinationFolder="$(RevisedDVRouteModDirectory)\audio" />
  </Target>

  <!-- Produces a Unity Mod Manager-ready archive beside the compiled DLL. -->
  <Target Name="PackageRevisedDVRoute" AfterTargets="Build">
    <PropertyGroup>
      <RevisedDVRoutePackageDirectory>$(TargetDir)package\$(AssemblyName)</RevisedDVRoutePackageDirectory>
      <RevisedDVRoutePackageZip>$(TargetDir)$(AssemblyName).zip</RevisedDVRoutePackageZip>
    </PropertyGroup>
    <ItemGroup>
      <RevisedDVRoutePackageFiles Include="$(TargetPath);$(ProjectDir)..\Info.json;$(TargetDir)PriorityQueue.dll" />
      <RevisedDVRoutePackageAudio Include="$(ProjectDir)Resources\audio\*.wav" />
    </ItemGroup>
    <RemoveDir Directories="$(RevisedDVRoutePackageDirectory)" Condition="Exists('$(RevisedDVRoutePackageDirectory)')" />
    <MakeDir Directories="$(RevisedDVRoutePackageDirectory);$(RevisedDVRoutePackageDirectory)\audio" />
    <Copy SourceFiles="@(RevisedDVRoutePackageFiles)" DestinationFolder="$(RevisedDVRoutePackageDirectory)" />
    <Copy SourceFiles="@(RevisedDVRoutePackageAudio)" DestinationFolder="$(RevisedDVRoutePackageDirectory)\audio" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(RevisedDVRoutePackageDirectory)\*' -DestinationPath '$(RevisedDVRoutePackageZip)' -Force&quot;" />
  </Target>
